

# DATABASE CONFIGURATION
# For PostgreSQL (Production):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backend_assignment
# For SQLite (Local Development - uncomment to use):
# DATABASE_URL=sqlite:///./backend_assignment.db

# JWT/AUTHENTICATION CONFIGURATION
# IMPORTANT: Change SECRET_KEY in production! Generate with: openssl rand -hex 32
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# REDIS CONFIGURATION (for caching and rate limiting)
# If Redis is not available, app will use in-memory fallback
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# APPLICATION SETTINGS
APP_NAME=Backend Assignment API
DEBUG=True
API_V1_PREFIX=/api/v1
API_V2_PREFIX=/api/v2

# CORS CONFIGURATION
# Comma-separated list of allowed origins (frontend URLs)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# RATE LIMITING
# Requests per minute for authenticated users
RATE_LIMIT_PER_MINUTE=100
# Requests per minute per IP for public endpoints
RATE_LIMIT_PER_MINUTE_IP=300
